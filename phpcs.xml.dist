<?xml version="1.0"?>
<ruleset name="Formlyx">
	<description>WordPress Coding Standards for Formlyx.</description>

	<file>formlyx.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<file>tests</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/tests/php/bootstrap.php</exclude-pattern>
	<exclude-pattern>*/tests/php/integration/bootstrap.php</exclude-pattern>

	<!--
		PSR-4 class files use the class name. WordPress hyphenated file names
		would not match the Formlyx\ autoload prefix.
	-->
	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals"/>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="formlyx"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="formlyx"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_supported_wp_version" value="6.7"/>
	<config name="testVersion" value="7.4-"/>
</ruleset>
