{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "formlyx/form",
	"title": "Formlyx Form",
	"category": "widgets",
	"description": "Embed a published Formlyx form on your website.",
	"keywords": [ "form", "formlyx" ],
	"textdomain": "formlyx",
	"attributes": {
		"formId": {
			"type": "string",
			"default": ""
		},
		"theme": {
			"type": "string",
			"default": "auto"
		}
	},
	"supports": {
		"html": false,
		"multiple": true,
		"reusable": true
	},
	"editorScript": "file:./index.js"
}
