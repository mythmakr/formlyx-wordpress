{
  "name": "formlyx-wordpress-walkthrough",
  "private": true,
  "version": "1.0.0",
  "description": "1920x1080 walkthrough for the Formlyx Forms WordPress plugin",
  "type": "module",
  "scripts": {
    "capture": "node capture.mjs",
    "dev": "remotion studio",
    "render": "remotion render FormlyxWordPressWalkthrough out/formlyx-wordpress-walkthrough-framed.mp4 --codec=h264 --crf=18",
    "render:narrated": "remotion render FormlyxWordPressWalkthrough out/formlyx-wordpress-walkthrough-narrated.mp4 --codec=h264 --crf=18 --audio-codec=aac",
    "render:narrated:revised": "remotion render FormlyxWordPressWalkthrough out/formlyx-wordpress-walkthrough-narrated-revised.mp4 --codec=h264 --crf=18 --audio-codec=aac",
    "still": "remotion still FormlyxWordPressThumbnail out/formlyx-wordpress-thumbnail.png --frame=0"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "playwright": "1.56.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.9.3"
  }
}
