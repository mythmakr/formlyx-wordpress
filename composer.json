{
	"name": "razorsoft/formlyx",
	"description": "Connect Formlyx to WordPress and embed hosted forms.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"formlyx"
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"Formlyx\\": "includes/"
		}
	},
	"scripts": {
		"analyse": "phpstan analyse --memory-limit=1G",
		"compat": "phpcs -p --standard=phpcs-compat.xml.dist",
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"syntax": "find formlyx.php uninstall.php includes tests -name '*.php' -exec php -l {} +",
		"test": "phpunit --configuration phpunit.xml.dist",
		"test:integration": "phpunit --configuration phpunit.integration.xml.dist"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"sort-packages": true
	},
	"prefer-stable": true
}
